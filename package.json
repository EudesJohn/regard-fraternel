{
  "name": "regard-fraternel-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:admin": "npm --prefix admin run dev",
    "build:admin": "npm --prefix admin run build",
    "build:all": "npm run build && npm run build:admin && node scripts/merge-admin.mjs",
    "test": "node --test tests/validation.test.mjs tests/gate.test.mjs tests/modules.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
